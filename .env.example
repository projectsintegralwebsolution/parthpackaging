# Parth Packaging — Project Environment Variables Template
# Copy this file to backend/.env and .env.local as needed.

# Backend Service
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://parthpackaging.com

# SMTP Credentials
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=enquiries@parthpackaging.com
SMTP_PASS=YOUR_SECURE_SMTP_PASSWORD
SMTP_FROM="Parth Packaging" <enquiries@parthpackaging.com>

# Notification Recipients
PARTH_PACKAGING_EMAIL=info@parthpackaging.com
INTEGRAL_WEB_SOLUTION_EMAIL=princekumarjha80@gmail.com

# Database
DATABASE_URL=sqlite:./data/enquiries.db

# Frontend Next.js API Proxy Target (Optional: only needed if frontend calls external backend directly)
# NEXT_PUBLIC_API_URL=http://localhost:5000
# BACKEND_API_URL=http://localhost:5000
