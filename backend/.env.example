# Parth Packaging — Backend Environment Variables Configuration Template
# Copy this file to .env and populate with your production credentials.
# NEVER commit your actual .env file with real credentials to GitHub.

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS & Security Headers
# For local testing use: http://localhost:3000 (or http://localhost:3005)
# In production, use your actual canonical domain:
FRONTEND_URL=https://parthpackaging.com

# SMTP Email Configuration (Nodemailer)
# Configure your SMTP provider credentials (e.g., Hostinger, Google Workspace, AWS SES, SendGrid)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=enquiries@parthpackaging.com
SMTP_PASS=YOUR_SECURE_SMTP_PASSWORD
SMTP_FROM="Parth Packaging" <enquiries@parthpackaging.com>

# Three-Way Email Notification Recipients
# 1. Customer: Automatically addressed to customer's submitted email address
# 2. Owner: Parth Packaging owner / management notification recipient
PARTH_PACKAGING_EMAIL=info@parthpackaging.com
# 3. Web Partner: Integral Web Solution notification recipient (must remain princekumarjha80@gmail.com)
INTEGRAL_WEB_SOLUTION_EMAIL=princekumarjha80@gmail.com

# Persistent Database Configuration
# Default: Local zero-dependency SQLite storage at backend/data/enquiries.db
# To use an external database (e.g., PostgreSQL or custom path), specify connection string or path:
DATABASE_URL=sqlite:./data/enquiries.db

# Optional Security Settings
# Rate Limit: Maximum enquiries allowed per IP in window (default: 10 per 15 minutes)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
