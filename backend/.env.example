# Parth Packaging Backend Environment Variables
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://YOUR-WEBSITE-DOMAIN.com

# SMTP Transport Configuration (Nodemailer)
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_VERIFIED_SENDER_EMAIL

# Notification Recipients
PARTH_PACKAGING_EMAIL=OWNER_EMAIL_ADDRESS
INTEGRAL_WEB_SOLUTION_EMAIL=princekumarjha80@gmail.com
